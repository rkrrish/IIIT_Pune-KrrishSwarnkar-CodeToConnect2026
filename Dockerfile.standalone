# ==============================================================================
# S&P 100 NLP Risk Engine — Standalone All-In-One Dockerfile
# Combines Frontend + Backend into a SINGLE portable Docker container image.
# Perfect for distribution: run `docker save` to export and share a single file!
# ==============================================================================

# --- Stage 1: Build React Frontend ---
FROM node:20-alpine AS frontend-builder
WORKDIR /app/frontend

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# --- Stage 2: Python Backend Runtime & Unified Server ---
FROM python:3.10-slim

LABEL maintainer="IIT Pune — Code to Connect 2026"
LABEL description="S&P 100 NLP Risk Engine — All-in-One Standalone Container"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8000 \
    HOST=0.0.0.0 \
    HF_HOME=/root/.cache/huggingface \
    TRANSFORMERS_CACHE=/root/.cache/huggingface \
    TORCH_HOME=/root/.cache/torch

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

ARG TORCH_INDEX=https://download.pytorch.org/whl/cpu

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir torch>=2.0.0 --index-url ${TORCH_INDEX} && \
    pip install --no-cache-dir -r requirements.txt

# Pre-cache Hugging Face base models for offline execution
RUN python -c "from transformers import AutoTokenizer, AutoModel, AutoModelForSequenceClassification; \
    print('Downloading ProsusAI/finbert...'); \
    AutoTokenizer.from_pretrained('ProsusAI/finbert'); \
    AutoModelForSequenceClassification.from_pretrained('ProsusAI/finbert'); \
    print('Downloading microsoft/deberta-v3-base...'); \
    AutoTokenizer.from_pretrained('microsoft/deberta-v3-base'); \
    AutoModel.from_pretrained('microsoft/deberta-v3-base'); \
    print('All base models successfully cached!')"

# Copy backend code, data, and models
COPY src/ ./src/
COPY data/ ./data/

# Copy compiled frontend from Stage 1 into /app/frontend/dist
# (FastAPI automatically serves this on http://localhost:8000)
COPY --from=frontend-builder /app/frontend/dist ./frontend/dist

# Create runtime directories
RUN mkdir -p \
    src/output/rebalancing_outputs \
    src/output/risk_engine_outputs \
    src/output/stress_test_outputs \
    data/live_mode_fetched

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/api/ping || exit 1

CMD ["uvicorn", "src.api:app", "--host", "0.0.0.0", "--port", "8000"]
